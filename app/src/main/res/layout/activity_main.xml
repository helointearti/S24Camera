<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Aperçu caméra (le ratio est ajusté depuis le code : 3:4 ou 9:16) -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="72dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <com.s24camera.app.GridOverlayView
            android:id="@+id/gridOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <View
            android:id="@+id/focusRing"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/focus_ring"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:shadowColor="#AA000000"
            android:shadowRadius="8"
            android:textColor="@android:color/white"
            android:textSize="110sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Barre du haut -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnFlash"
            style="@style/TopIcon"
            android:contentDescription="@string/flash"
            android:src="@drawable/ic_flash_off" />

        <TextView
            android:id="@+id/btnTimer"
            style="@style/TopIcon"
            android:contentDescription="@string/timer"
            android:drawablePadding="2dp"
            app:drawableStartCompat="@drawable/ic_timer" />

        <TextView
            android:id="@+id/btnRatio"
            style="@style/TopIcon"
            android:contentDescription="@string/ratio"
            android:text="3:4" />

        <ImageButton
            android:id="@+id/btnGrid"
            style="@style/TopIcon"
            android:alpha="0.5"
            android:contentDescription="@string/grid"
            android:src="@drawable/ic_grid" />
    </LinearLayout>

    <!-- Indicateur d'enregistrement -->
    <LinearLayout
        android:id="@+id/recordingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/recDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/rec_dot" />

        <TextView
            android:id="@+id/recordTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sélecteur de zoom (caméras arrière) -->
    <LinearLayout
        android:id="@+id/zoomBar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toTopOf="@id/modeBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bouton grand angle (caméra frontale) -->
    <LinearLayout
        android:id="@+id/frontWideBar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/modeBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnFrontNormal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@null"
            android:contentDescription="@string/wide_off"
            android:src="@drawable/ic_person" />

        <ImageButton
            android:id="@+id/btnFrontWide"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_selected"
            android:contentDescription="@string/front_wide"
            android:src="@drawable/ic_group" />
    </LinearLayout>

    <!-- Modes -->
    <LinearLayout
        android:id="@+id/modeBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/modePhoto"
            style="@style/ModeText"
            android:text="@string/mode_photo"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/modeVideo"
            style="@style/ModeText"
            android:text="@string/mode_video"
            android:textColor="@color/mode_inactive" />
    </LinearLayout>

    <!-- Barre du bas -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/galleryThumb"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="40dp"
            android:background="@drawable/bg_thumb"
            android:contentDescription="@string/gallery"
            android:padding="2dp"
            android:scaleType="centerCrop" />

        <!-- Photo pendant l'enregistrement vidéo -->
        <ImageButton
            android:id="@+id/btnSnapshot"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="36dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/snapshot"
            android:src="@drawable/ic_camera"
            android:visibility="gone" />

        <com.s24camera.app.ShutterButton
            android:id="@+id/shutter"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:contentDescription="@string/shutter" />

        <ImageButton
            android:id="@+id/btnSwitch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="38dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/switch_camera"
            android:src="@drawable/ic_switch_camera" />

        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="38dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/pause"
            android:src="@drawable/ic_pause"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Flash d'écran (selfie) et effet de déclenchement -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
